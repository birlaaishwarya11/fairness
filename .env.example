# ─── FairSight backend keys (used by the FastAPI server) ─────────────────────
# No Anthropic key needed — users supply their own API key via the request body
TAVILY_API_KEY=tvly-...

# ─── Daytona sandbox config ───────────────────────────────────────────────────
# Get your API key from https://app.daytona.io/account
DAYTONA_API_KEY=daytona-...
# Leave blank to use the default Daytona Cloud; set for self-hosted Daytona
DAYTONA_SERVER_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# ─── Gemini (for POST /api/policy-redteam) ────────────────────────────────────
# Used for policy ingestion, semantic diff scoring, and adversarial prompt generation
GEMINI_API_KEY=AIza...
# Optional: override the default model (gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# ─── CORS (comma-separated, use * for dev) ────────────────────────────────────
# Include localhost:3000 for local frontend dev and your Vercel deploy URL
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ─── Optional: lock to Lovable domain in production ──────────────────────────
# ALLOWED_ORIGINS=https://your-app.lovable.app,https://fairsight.ai
